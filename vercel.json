{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/process",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/process.html",
      "destination": "/services",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin-login.html"
    },
    {
      "source": "/admin/analytics",
      "destination": "/admin.html"
    },
    {
      "source": "/insights/:slug",
      "destination": "/insight.html"
    },
    {
      "source": "/projects/:slug",
      "destination": "/project.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
